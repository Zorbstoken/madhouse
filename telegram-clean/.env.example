# Copy to .env on the host only. Never commit a real .env, never paste a token in chat.
# TELEGRAM_BOT_TOKEN is created by the user on his phone in @BotFather, for the FRESH bot only.
# This file holds no token. The loader reads the environment, not this file.
TELEGRAM_BOT_TOKEN=
WEBAPP_URL=https://zorbstoken.github.io/madhouse/telegram-clean/
# Optional webhook mode. Leave WEBHOOK_URL empty for the first-load polling test.
WEBHOOK_URL=
WEBHOOK_SECRET=
PORT=8080
